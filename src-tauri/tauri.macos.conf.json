{
  "bundle": {
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/app.icns"
    ],
    "macOS": {
      "files": {
        "Library/LaunchAgents/com.tiez.autostart.plist": "macos/com.tiez.autostart.plist"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "TieZ",
        "label": "main",
        "width": 352,
        "height": 380,
        "minWidth": 250,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": false,
        "decorations": true,
        "devtools": false,
        "skipTaskbar": true,
        "visible": true,
        "visibleOnAllWorkspaces": true,
        "dragDropEnabled": false,
        "acceptFirstMouse": true,
        "focusable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  }
}
